# ODIN V2 Backend — Environment Configuration
# Copy to .env and fill in values

# API
API_HOST=127.0.0.1
API_PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./odin.db

# Security (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=your-secret-key-here-min-32-chars

# CORS (comma-separated, parsed as CORS_ORIGINS_RAW)
CORS_ORIGINS_RAW=http://localhost:5173,http://127.0.0.1:5173,exp://192.168.1.0/24:8081

# Hermes Integration
HERMES_API_URL=http://127.0.0.1:9119
# HERMES_SESSION_TOKEN is auto-populated from Hermes at startup
# Or set manually: HERMES_SESSION_TOKEN=your-token

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json