{
  "expo": {
    "name": "ODIN V2 Mobile",
    "slug": "odin-mobile-v2",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "odin-v2",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050608",
    "platforms": ["android", "ios"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.odin.mobile.v2",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.odin.mobile.v2",
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#050608"
      }
    },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", {"backgroundColor": "#050608"}],
      ["expo-build-properties", {"android": {"usesCleartextTraffic": true}}]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    }
  }
}
